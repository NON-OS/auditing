{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A published finding",
  "description": "A finding that has been verified, reported to the maintainers and then fixed, accepted as a risk, or disputed. Nothing else is stored in this repository.",
  "type": "object",
  "required": [
    "id",
    "title",
    "component",
    "severity",
    "confidence",
    "adversary",
    "affected",
    "location",
    "cvss",
    "description",
    "impact",
    "scenario",
    "evidence",
    "remediation",
    "status",
    "dates"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^NKA-[0-9]{4}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "component": {
      "type": "string",
      "minLength": 2
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "confidence": {
      "enum": [
        "confirmed",
        "supported"
      ]
    },
    "adversary": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "A4",
        "A5"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "affected": {
      "type": "object",
      "required": [
        "release",
        "main",
        "commits"
      ],
      "properties": {
        "release": {
          "type": "boolean"
        },
        "main": {
          "type": "boolean"
        },
        "commits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "location": {
      "type": "string",
      "minLength": 3
    },
    "cvss": {
      "type": "string",
      "pattern": "^CVSS:4\\.0/.+"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "impact": {
      "type": "string",
      "minLength": 10
    },
    "scenario": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "reproduced",
        "steps"
      ],
      "properties": {
        "reproduced": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "harness": {
          "type": "string"
        }
      }
    },
    "remediation": {
      "type": "string",
      "minLength": 10
    },
    "regression_check": {
      "type": "string"
    },
    "status": {
      "enum": [
        "fixed",
        "accepted-risk",
        "disputed"
      ]
    },
    "fix": {
      "type": "object",
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "dates": {
      "type": "object",
      "required": [
        "reported",
        "published"
      ],
      "properties": {
        "reported": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "fixed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "published": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 10
    }
  }
}
