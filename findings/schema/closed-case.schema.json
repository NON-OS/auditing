{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A closed candidate",
  "description": "A candidate that a worker wrote up and a second, independent reviewer checked and refuted: shown not to be a finding, with the reasoning and the routes tried to break it.",
  "type": "object",
  "required": [
    "id",
    "title",
    "component",
    "claim",
    "location",
    "why_not_a_finding",
    "routes_tried",
    "dates"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^NKA-CLOSED-[0-9]{4}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "component": {
      "type": "string",
      "minLength": 2
    },
    "claim": {
      "type": "string",
      "minLength": 20,
      "description": "What the candidate suspected, in one or two sentences"
    },
    "location": {
      "type": "string",
      "minLength": 3
    },
    "affected": {
      "type": "object",
      "properties": {
        "release": { "type": "boolean" },
        "main": { "type": "boolean" },
        "main_checked": { "type": "boolean" },
        "commits": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "why_not_a_finding": {
      "type": "string",
      "minLength": 20,
      "description": "The actual reason: unreachable precondition, an existing check already stops it, documented and intended behavior, or the evidence did not reproduce"
    },
    "routes_tried": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "checked_independently": { "type": "boolean" },
        "steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "dates": {
      "type": "object",
      "required": ["reported", "closed"],
      "properties": {
        "reported": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "closed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  }
}
